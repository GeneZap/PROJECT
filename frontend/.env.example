# Required for production / Vercel: public HTTPS API (no trailing slash).
# Set in Vercel → Project → Settings → Environment Variables for Production & Preview.
# VITE_API_BASE_URL=https://your-api.onrender.com

# Local development (optional — defaults to http://localhost:8000 in src/config.js)
# VITE_API_BASE_URL=http://127.0.0.1:8000
