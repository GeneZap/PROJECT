# Local development environment for GeneZap backend
GENEZAP_ENV=development
GENEZAP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
GENEZAP_CORS_CREDENTIALS=true
GENEZAP_LOG_LEVEL=INFO
GENEZAP_MAX_UPLOAD_MB=100
GENEZAP_MAX_POOL_FILE_MB=100
GENEZAP_MAX_POOL_FILES_PER_REQUEST=25
GENEZAP_MAX_BATCH_FILES=50
GENEZAP_DATASETS_ROOT=d:\MY_GITHUB_PROJECT\BV-BRC_Dataset\data\datasets
GENEZAP_ALLOW_DATASET_PATH_IMPORT=1
