# Copy to .env locally (do not commit secrets). Container: pass via platform env UI.

# --- Runtime profile ---
# production | prod | staging → disables server-side path import; tune defaults
GENEZAP_ENV=production

# --- HTTP / CORS ---
# Comma-separated browser origins (recommended in production), e.g.:
# GENEZAP_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# If unset, wildcard * is used with credentials disabled.
GENEZAP_CORS_ORIGINS=
# Only honored when origins are not wildcard:
GENEZAP_CORS_CREDENTIALS=false

# --- Logging ---
GENEZAP_LOG_LEVEL=INFO

# --- Upload & pool limits (free-tier friendly defaults) ---
GENEZAP_MAX_UPLOAD_MB=100
GENEZAP_MAX_POOL_FILE_MB=100
GENEZAP_MAX_POOL_FILES_PER_REQUEST=25
GENEZAP_MAX_BATCH_FILES=50

# --- Dataset pool storage (filesystem; use mounted volume in production) ---
GENEZAP_DATASETS_ROOT=/data/datasets

# --- Integrated hackathon artifact bundle (V1/V2/V3/V4 + CARD under one tree) ---
# Default: <repo>/CV_HACKATHON_MODEL_DATASET (sibling of backend/). Override in Docker if layout differs.
# GENEZAP_CV_ARTIFACT_ROOT=/app/CV_HACKATHON_MODEL_DATASET

# --- Local development only: copy FASTA from server directory into a pool ---
# Ignored when GENEZAP_ENV is production/prod/staging.
GENEZAP_ALLOW_DATASET_PATH_IMPORT=0

# --- TensorFlow (optional skip for CI / CPU-less smoke tests) ---
# GENEZAP_SKIP_TENSORFLOW=1
